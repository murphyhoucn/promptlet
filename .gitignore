# Local SDK, build/publish outputs, audit evidence and private previews.
/.tools/
/artifacts/
/.screenshots/
/.local/
/.cleanup/

# .NET build and test outputs (all projects).
[Bb]in/
[Oo]bj/
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
*.binlog

# Visual Studio / Rider user state; shared launchSettings.json stays tracked.
.vs/
.idea/
_ReSharper*/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user
*.dotCover
*.pubxml.user

# Logs, including errors.log.1, and transient files.
[Ll]og/
[Ll]ogs/
*.log
*.log.*
*.tmp
*.dmp

# Runtime settings and encrypted credential backups are private too.
settings.json
settings.json.tmp
settings.json.v1.backup
settings.local.json
.env
.env.*
!.env.example
!.env.template
.secrets/
*.pfx
*.p12
*.snk

# NuGet/MSIX output; preserve packages.lock.json and NuGet.Config.
*.nupkg
*.snupkg
AppPackages/
BundleArtifacts/
publish/
*.msix
*.msixbundle
*.msixupload
*.appx
*.appxbundle
*.appxupload

# Python helpers and Windows/macOS editor debris.
__pycache__/
*.py[cod]
[Tt]humbs.db
[Dd]esktop.ini
.DS_Store
*.swp
*.swo
