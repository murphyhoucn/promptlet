<Window
    x:Class="Promptlet.PromptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Promptlet">
    <!-- Fill the complete client area; only DWM clips the outer window corners. -->
    <Border x:Name="Surface" BorderThickness="0"
            Background="{ThemeResource PromptSurfaceBrush}">
        <Grid x:Name="Root" Background="Transparent" Padding="24,20,24,16" RowSpacing="20" KeyboardAcceleratorPlacementMode="Hidden">
            <Grid.Resources>
                <!-- Scope native TextBox visual-state overrides to these two card surfaces only. -->
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
                <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image x:Name="BrandLogo" Width="36" Height="36" Source="{ThemeResource PromptLogoImage}" AutomationProperties.Name="Promptlet Logo" />
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Promptlet" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="提示词，恰到好处" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border CornerRadius="10" Padding="8,4" Background="{ThemeResource PromptAccentSoftBrush}"><TextBlock x:Name="TemplateLabel" Text="科研项目" MaxWidth="100" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource PromptAccentBrush}" /></Border>
                    <Border CornerRadius="10" Padding="8,4" Background="{ThemeResource PromptAccentSoftBrush}"><TextBlock x:Name="ModelLabel" Text="未配置模型" MaxWidth="120" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource PromptAccentBrush}" /></Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <Button Click="OpenSettings" Background="Transparent" BorderThickness="0" Padding="9" ToolTipService.ToolTip="设置" AutomationProperties.Name="设置">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </Button>
                    <Button Click="HideClicked" Background="Transparent" BorderThickness="0" Padding="9" ToolTipService.ToolTip="隐藏窗口（请求继续）" AutomationProperties.Name="隐藏窗口">
                        <FontIcon Glyph="&#xE8BB;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="IntroPanel" Grid.Row="1" Spacing="8" Margin="0,4">
                <TextBlock Text="把想法，变成清晰的指令。" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="一次快捷键，让表达更准确。" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Border x:Name="RawCard" Grid.Row="2" Padding="16,12" CornerRadius="16" Background="{ThemeResource PromptCardBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="原文" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8"><TextBlock x:Name="CharacterCount" Text="0 / 20,000" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><Button x:Name="DiscardButton" Content="放弃编辑" Click="DiscardClicked" Visibility="Collapsed" Padding="8,4"/><Button x:Name="EditButton" Content="编辑" Click="EditClicked" Padding="8,4" Background="Transparent" BorderThickness="0" FontSize="12"/></StackPanel>
                    </Grid>
                    <TextBox x:Name="RawBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="120" TextChanged="RawTextChanged"
                             PlaceholderText="先复制一段文字，或点击编辑输入。" Background="Transparent" BorderThickness="0" Padding="0,4" UseSystemFocusVisuals="False"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="原始提示词" />
                </Grid>
            </Border>
            <Border x:Name="ResultCard" Grid.Row="3" Padding="16,12" CornerRadius="16" Background="{ThemeResource PromptCardBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="优化结果" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="ResultHint" Text="完成后自动复制" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <TextBox x:Name="ResultBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                         PlaceholderText="清晰的提示词，即将在这里出现。" Background="Transparent" BorderThickness="0" Padding="0,4" UseSystemFocusVisuals="False"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="优化后的提示词" />
            </Grid>
            </Border>
            <Grid Grid.Row="4" ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing x:Name="BusyRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" Text="复制一段想法，按快捷键开始。" FontSize="12" TextWrapping="Wrap" MaxWidth="310" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CancelButton" Content="取消" Click="CancelClicked" Visibility="Collapsed" MinWidth="88" />
                    <Button x:Name="CopyButton" Content="复制结果" Click="CopyClicked" Visibility="Collapsed" MinWidth="100" />
                    <Button x:Name="OptimizeButton" Content="开始优化" Click="OptimizeClicked" Style="{StaticResource AccentButtonStyle}" MinWidth="100" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="5">
                <TextBlock x:Name="ShortcutHint" Text="Ctrl + Alt + Space 唤起" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Esc 取消并隐藏" HorizontalAlignment="Right" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Grid>
    </Border>
</Window>
